// prisma/schema.prisma
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id         String   @id @default(uuid())
    email      String   @unique
    password   String
    name       String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    avatarHash String?

    watchedEpisodes WatchedEpisode[]
    comments        Comment[]
    favorites       FavoriteAnime[]
}

model Anime {
    id          String   @id @default(uuid())
    title       String
    description String?
    coverImage  String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    comments       Comment[]
    favorites      FavoriteAnime[]
    WatchedEpisode WatchedEpisode[]
}

model WatchedEpisode {
    id        String   @id @default(uuid())
    userId    String
    animeId   String
    episode   Int
    position  Int // posição em segundos onde parou
    updatedAt DateTime @updatedAt

    user  User  @relation(fields: [userId], references: [id])
    anime Anime @relation(fields: [animeId], references: [id])
}

model FavoriteAnime {
    id        String   @id @default(uuid())
    userId    String
    animeId   String
    createdAt DateTime @default(now())

    user  User  @relation(fields: [userId], references: [id])
    anime Anime @relation(fields: [animeId], references: [id])
}

model Comment {
    id        String   @id @default(uuid())
    content   String
    userId    String
    animeId   String
    createdAt DateTime @default(now())

    user  User  @relation(fields: [userId], references: [id])
    anime Anime @relation(fields: [animeId], references: [id])
}
